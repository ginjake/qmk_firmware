# Build Options
#   change yes to no to disable
#
BOOTMAGIC_ENABLE = no       # Enable Bootmagic Lite
MOUSEKEY_ENABLE = no        # Mouse keys (disabled to free USB endpoint)
EXTRAKEY_ENABLE = no        # Audio control and System control (disabled to free USB endpoint)
CONSOLE_ENABLE = no         # Console for debug
COMMAND_ENABLE = no        # Commands for debug and configuration
NKRO_ENABLE = no            # Enable N-Key Rollover (disabled to free USB endpoint)
BACKLIGHT_ENABLE = no      # Enable keyboard backlight functionality
AUDIO_ENABLE = no           # Audio output
RGBLIGHT_ENABLE = yes        # Enable WS2812 RGB underlight.
MIDI_ENABLE = no            # MIDI disabled (replaced with Raw HID)
RAW_ENABLE = yes            # Enable Raw HID for custom communication
